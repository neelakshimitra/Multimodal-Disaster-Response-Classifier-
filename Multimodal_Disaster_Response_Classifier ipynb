        "macro_vals    = [t['macro_f1']   for t in threshold_store]\n",
        "\n",
        "# Medical F1 by threshold\n",
        "axes[0].plot(\n",
        "    thresh_vals, medical_vals,\n",
        "    marker='o', color='coral',\n",
        "    linewidth=2, markersize=6,\n",
        "    label='Medical F1'\n",
        ")\n",
        "axes[0].axvline(\n",
        "    x=0.5, color='gray',\n",
        "    linestyle='--', alpha=0.7,\n",
        "    label='Default threshold (0.5)'\n",
        ")\n",
        "axes[0].axhline(\n",
        "    y=default_medical, color='coral',\n",
        "    linestyle=':', alpha=0.5,\n",
        "    label=f'Default medical F1 ({default_medical:.3f})'\n",
        ")\n",
        "axes[0].set_title('Medical Class F1 by Threshold')\n",
        "axes[0].set_xlabel('Classification Threshold')\n",
        "axes[0].set_ylabel('F1 Score')\n",
        "axes[0].set_ylim(0, 1)\n",
        "axes[0].legend(fontsize=9)\n",
        "axes[0].grid(True, alpha=0.3)\n",
        "\n",
        "# Macro F1 by threshold\n",
        "axes[1].plot(\n",
        "    thresh_vals, macro_vals,\n",
        "    marker='o', color='steelblue',\n",
        "    linewidth=2, markersize=6,\n",
        "    label='Macro F1'\n",
        ")\n",
        "axes[1].axvline(\n",
        "    x=0.5, color='gray',\n",
        "    linestyle='--', alpha=0.7,\n",
        "    label='Default threshold (0.5)'\n",
        ")\n",
        "axes[1].axhline(\n",
        "    y=default_macro, color='steelblue',\n",
        "    linestyle=':', alpha=0.5,\n",
        "    label=f'Default macro F1 ({default_macro:.3f})'\n",
        ")\n",
        "axes[1].set_title('Overall Macro F1 by Threshold')\n",
