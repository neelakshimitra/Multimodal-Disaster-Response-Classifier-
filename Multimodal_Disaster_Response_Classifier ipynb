      "source": [
        "# SECTION 4: Model Architectures\n",
        "# Defines five model configurations:\n",
        "# 4a: CNN Only Baseline (satellite imagery only)\n",
        "# 4b: DistilBERT Only Baseline (tweet text only)\n",
        "# 4c: Late Fusion (concatenation after independent encoding)\n",
        "# 4d: Early Fusion (element-wise addition in shared space)\n",
        "# 4e: Attention Fusion (bidirectional cross-attention)\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "import torchvision.models as models\n",
        "from torchvision.models import ResNet18_Weights\n",
        "from transformers import DistilBertModel\n",
        "\n",
        "# 4a: CNN Only Baseline\n",
        "\n",
        "class CNNBaseline(nn.Module):\n",
        "    \"\"\"\n",
        "    Image-only baseline using ResNet-18 pretrained on\n",
        "    ImageNet via ResNet18_Weights.DEFAULT.\n",
        "    Input:  satellite image [B, 3, 224, 224]\n",
        "    Output: class logits [B, num_classes]\n",
        "    \"\"\"\n",
        "    def __init__(self, num_classes=4,\n",
        "                 embedding_dim=256, dropout=0.3):\n",
        "        super(CNNBaseline, self).__init__()\n",
        "\n",
        "        resnet = models.resnet18(\n",
        "            weights=ResNet18_Weights.DEFAULT\n",
        "        )\n",
        "        modules = list(resnet.children())[:-1]\n",
        "        self.encoder = nn.Sequential(*modules)\n",
        "        self.projection = nn.Linear(512, embedding_dim)\n",
        "        self.classifier = nn.Sequential(\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(dropout),\n",
        "            nn.Linear(embedding_dim, num_classes)\n",
        "        )\n",
        "\n",
        "    def forward(self, image, **kwargs):\n",
        "        features = self.encoder(image)\n",
        "        features = features.squeeze(-1).squeeze(-1)\n",
        "        embedding = self.projection(features)\n",
        "        return self.classifier(embedding)\n",
        "\n",
        "    def get_embedding(self, image):\n",
        "        features = self.encoder(image)\n",
        "        features = features.squeeze(-1).squeeze(-1)\n",
        "        return F.relu(self.projection(features))\n",
        "\n",
        "\n",
        "# 4b: DistilBERT Only Baseline\n",
        "\n",
        "class TextBaseline(nn.Module):\n",
        "    \"\"\"\n",
        "    Text-only baseline using DistilBERT.\n",
        "    Input:  input_ids [B, seq_len]\n",
        "            attention_mask [B, seq_len]\n",
        "    Output: class logits [B, num_classes]\n",
        "    \"\"\"\n",
        "    def __init__(self, num_classes=4,\n",
        "                 embedding_dim=256, dropout=0.3):\n",
        "        super(TextBaseline, self).__init__()\n",
        "\n",
        "        self.encoder = DistilBertModel.from_pretrained(\n",
        "            'distilbert-base-uncased'\n",
        "        )\n",
        "        for param in self.encoder.parameters():\n",
        "            param.requires_grad = False\n",
        "        for param in (self.encoder.transformer\n",
        "                      .layer[-1].parameters()):\n",
        "            param.requires_grad = True\n",
        "\n",
        "        self.projection = nn.Linear(768, embedding_dim)\n",
        "        self.classifier = nn.Sequential(\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(dropout),\n",
        "            nn.Linear(embedding_dim, num_classes)\n",
        "        )\n",
        "\n",
        "    def forward(self, input_ids, attention_mask, **kwargs):\n",
        "        output = self.encoder(\n",
        "            input_ids=input_ids,\n",
        "            attention_mask=attention_mask\n",
        "        )\n",
        "        cls_token = output.last_hidden_state[:, 0, :]\n",
        "        embedding = self.projection(cls_token)\n",
        "        return self.classifier(embedding)\n",
        "\n",
        "    def get_embedding(self, input_ids, attention_mask):\n",
        "        output = self.encoder(\n",
        "            input_ids=input_ids,\n",
        "            attention_mask=attention_mask\n",
        "        )\n",
        "        cls_token = output.last_hidden_state[:, 0, :]\n",
        "        return F.relu(self.projection(cls_token))\n",
        "\n",
        "\n",
        "# 4c: Late Fusion Model\n",
        "\n",
        "class LateFusionModel(nn.Module):\n",
        "    \"\"\"\n",
        "    Late fusion multimodal model.\n",
        "    Independently encodes both modalities then concatenates.\n",
        "    Input:  image [B, 3, 224, 224]\n",
        "            input_ids [B, seq_len]\n",
        "            attention_mask [B, seq_len]\n",
        "    Output: class logits [B, num_classes]\n",
        "    \"\"\"\n",
        "    def __init__(self, num_classes=4,\n",
        "                 embedding_dim=256, dropout=0.3):\n",
        "        super(LateFusionModel, self).__init__()\n",
        "\n",
        "        resnet = models.resnet18(\n",
        "            weights=ResNet18_Weights.DEFAULT\n",
        "        )\n",
        "        modules = list(resnet.children())[:-1]\n",
        "        self.image_encoder = nn.Sequential(*modules)\n",
        "        self.image_projection = nn.Linear(512, embedding_dim)\n",
        "\n",
        "        self.text_encoder = DistilBertModel.from_pretrained(\n",
        "            'distilbert-base-uncased'\n",
        "        )\n",
        "        for param in self.text_encoder.parameters():\n",
        "            param.requires_grad = False\n",
        "        for param in (self.text_encoder.transformer\n",
        "                      .layer[-1].parameters()):\n",
        "            param.requires_grad = True\n",
        "        self.text_projection = nn.Linear(768, embedding_dim)\n",
        "\n",
        "        self.classifier = nn.Sequential(\n",
        "            nn.Linear(embedding_dim * 2, 128),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(dropout),\n",
        "            nn.Linear(128, num_classes)\n",
        "        )\n",
        "\n",
        "    def forward(self, image, input_ids,\n",
        "                attention_mask, **kwargs):\n",
        "        img_feat = self.image_encoder(image)\n",
        "        img_feat = img_feat.squeeze(-1).squeeze(-1)\n",
        "        img_emb  = F.relu(self.image_projection(img_feat))\n",
        "\n",
        "        txt_out  = self.text_encoder(\n",
        "            input_ids=input_ids,\n",
        "            attention_mask=attention_mask\n",
        "        )\n",
        "        txt_feat = txt_out.last_hidden_state[:, 0, :]\n",
        "        txt_emb  = F.relu(self.text_projection(txt_feat))\n",
        "\n",
        "        fused = torch.cat([img_emb, txt_emb], dim=1)\n",
        "        return self.classifier(fused)\n",
        "\n",
        "    def get_embeddings(self, image,\n",
        "                       input_ids, attention_mask):\n",
        "        img_feat = self.image_encoder(image)\n",
        "        img_feat = img_feat.squeeze(-1).squeeze(-1)\n",
        "        img_emb  = F.relu(self.image_projection(img_feat))\n",
        "\n",
        "        txt_out  = self.text_encoder(\n",
        "            input_ids=input_ids,\n",
        "            attention_mask=attention_mask\n",
        "        )\n",
        "        txt_feat = txt_out.last_hidden_state[:, 0, :]\n",
        "        txt_emb  = F.relu(self.text_projection(txt_feat))\n",
        "\n",
        "        return img_emb, txt_emb\n",
        "\n",
        "\n",
        "# 4d: Early Fusion Model\n",
        "# Combines modalities via element-wise addition in a shared\n",
        "# projected space. Implements early fusion via projected\n",
        "# feature combination rather than raw feature combination,\n",
        "# which is not applicable given heterogeneous input modalities (satellite imagery vs tweet text).\n",
        "\n",
        "class EarlyFusionModel(nn.Module):\n",
        "    \"\"\"\n",
        "    Early fusion multimodal model.\n",
        "    Projects both modalities to shared embedding space\n",
        "    and combines via element-wise addition before\n",
        "    classification.\n",
        "    Note: implements early fusion via projected feature\n",
        "    combination. True raw-feature early fusion is not\n",
        "    applicable given heterogeneous input modalities\n",
        "    (satellite imagery vs tweet text).\n",
        "    Input:  image [B, 3, 224, 224]\n",
        "            input_ids [B, seq_len]\n",
        "            attention_mask [B, seq_len]\n",
        "    Output: class logits [B, num_classes]\n",
        "    \"\"\"\n",
        "    def __init__(self, num_classes=4,\n",
        "                 embedding_dim=256, dropout=0.3):\n",
        "        super(EarlyFusionModel, self).__init__()\n",
        "\n",
        "        resnet = models.resnet18(\n",
        "            weights=ResNet18_Weights.DEFAULT\n",
        "        )\n",
        "        modules = list(resnet.children())[:-1]\n",
        "        self.image_encoder = nn.Sequential(*modules)\n",
        "\n",
        "        self.text_encoder = DistilBertModel.from_pretrained(\n",
        "            'distilbert-base-uncased'\n",
        "        )\n",
        "        for param in self.text_encoder.parameters():\n",
        "            param.requires_grad = False\n",
        "        for param in (self.text_encoder.transformer\n",
        "                      .layer[-1].parameters()):\n",
        "            param.requires_grad = True\n",
        "\n",
        "        self.image_projection = nn.Linear(512, embedding_dim)\n",
        "        self.text_projection  = nn.Linear(768, embedding_dim)\n",
        "\n",
        "        self.fusion_layer = nn.Sequential(\n",
        "            nn.Linear(embedding_dim, embedding_dim),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(dropout)\n",
        "        )\n",
        "\n",
        "        self.classifier = nn.Linear(\n",
        "            embedding_dim, num_classes\n",
        "        )\n",
        "\n",
        "    def forward(self, image, input_ids,\n",
        "                attention_mask, **kwargs):\n",
        "        img_feat = self.image_encoder(image)\n",
        "        img_feat = img_feat.squeeze(-1).squeeze(-1)\n",
        "        img_proj = self.image_projection(img_feat)\n",
        "\n",
        "        txt_out  = self.text_encoder(\n",
        "            input_ids=input_ids,\n",
        "            attention_mask=attention_mask\n",
        "        )\n",
        "        txt_feat = txt_out.last_hidden_state[:, 0, :]\n",
        "        txt_proj = self.text_projection(txt_feat)\n",
        "\n",
        "        # Early fusion: element-wise addition\n",
        "        fused = img_proj + txt_proj\n",
        "        fused = self.fusion_layer(fused)\n",
        "\n",
        "        return self.classifier(fused)\n",
        "\n",
        "\n",
        "# 4e: Attention-Based Joint Fusion Model\n",
        "\n",
        "class AttentionFusionModel(nn.Module):\n",
        "    \"\"\"\n",
        "    Attention-based joint fusion model.\n",
        "    Bidirectional cross-attention between modalities.\n",
        "    Text attends to image features and vice versa.\n",
        "    Input:  image [B, 3, 224, 224]\n",
        "            input_ids [B, seq_len]\n",
        "            attention_mask [B, seq_len]\n",
        "    Output: class logits [B, num_classes]\n",
        "    \"\"\"\n",
        "    def __init__(self, num_classes=4,\n",
        "                 embedding_dim=256,\n",
        "                 num_heads=4, dropout=0.3):\n",
        "        super(AttentionFusionModel, self).__init__()\n",
        "\n",
        "        resnet = models.resnet18(\n",
        "            weights=ResNet18_Weights.DEFAULT\n",
        "        )\n",
        "        modules = list(resnet.children())[:-1]\n",
        "        self.image_encoder     = nn.Sequential(*modules)\n",
        "        self.image_projection  = nn.Linear(512, embedding_dim)\n",
        "\n",
        "        self.text_encoder = DistilBertModel.from_pretrained(\n",
        "            'distilbert-base-uncased'\n",
        "        )\n",
        "        for param in self.text_encoder.parameters():\n",
        "            param.requires_grad = False\n",
        "        for param in (self.text_encoder.transformer\n",
        "                      .layer[-1].parameters()):\n",
        "            param.requires_grad = True\n",
        "        self.text_projection = nn.Linear(768, embedding_dim)\n",
        "\n",
        "        self.text_to_image_attention = nn.MultiheadAttention(\n",
        "            embed_dim=embedding_dim,\n",
        "            num_heads=num_heads,\n",
        "            dropout=dropout,\n",
        "            batch_first=True\n",
        "        )\n",
        "        self.image_to_text_attention = nn.MultiheadAttention(\n",
        "            embed_dim=embedding_dim,\n",
        "            num_heads=num_heads,\n",
        "            dropout=dropout,\n",
        "            batch_first=True\n",
        "        )\n",
        "\n",
        "        self.norm_txt = nn.LayerNorm(embedding_dim)\n",
        "        self.norm_img = nn.LayerNorm(embedding_dim)\n",
        "\n",
        "        self.classifier = nn.Sequential(\n",
        "            nn.Linear(embedding_dim * 2, 128),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(dropout),\n",
        "            nn.Linear(128, num_classes)\n",
        "        )\n",
        "\n",
        "    def forward(self, image, input_ids,\n",
        "                attention_mask, **kwargs):\n",
        "        img_feat = self.image_encoder(image)\n",
        "        img_feat = img_feat.squeeze(-1).squeeze(-1)\n",
        "        img_emb  = F.relu(self.image_projection(img_feat))\n",
        "        img_emb  = img_emb.unsqueeze(1)\n",
        "\n",
        "        txt_out  = self.text_encoder(\n",
        "            input_ids=input_ids,\n",
        "            attention_mask=attention_mask\n",
        "        )\n",
        "        txt_feat = txt_out.last_hidden_state[:, 0, :]\n",
        "        txt_emb  = F.relu(self.text_projection(txt_feat))\n",
        "        txt_emb  = txt_emb.unsqueeze(1)\n",
        "\n",
        "        attended_txt, _ = self.text_to_image_attention(\n",
        "            query=txt_emb, key=img_emb, value=img_emb\n",
        "        )\n",
        "        attended_txt = self.norm_txt(txt_emb + attended_txt)\n",
        "\n",
        "        attended_img, _ = self.image_to_text_attention(\n",
        "            query=img_emb, key=txt_emb, value=txt_emb\n",
        "        )\n",
        "        attended_img = self.norm_img(img_emb + attended_img)\n",
        "\n",
        "        attended_txt = attended_txt.squeeze(1)\n",
        "        attended_img = attended_img.squeeze(1)\n",
        "\n",
        "        fused = torch.cat(\n",
        "            [attended_txt, attended_img], dim=1\n",
        "        )\n",
        "        return self.classifier(fused)\n",
        "\n",
        "\n",
        "# 4f: Model Factory\n",
        "\n",
        "def create_model(model_type):\n",
        "    \"\"\"\n",
        "    Factory function to create models by name.\n",
        "    Args:\n",
        "        model_type: 'cnn', 'text', 'late',\n",
        "                    'early', 'attention'\n",
        "    Returns:\n",
        "        model moved to device\n",
        "    \"\"\"\n",
        "    models_dict = {\n",
        "        'cnn':       CNNBaseline,\n",
        "        'text':      TextBaseline,\n",
        "        'late':      LateFusionModel,\n",
        "        'early':     EarlyFusionModel,\n",
        "        'attention': AttentionFusionModel\n",
        "    }\n",
        "\n",
        "    if model_type not in models_dict:\n",
        "        raise ValueError(\n",
        "            f\"Unknown model: {model_type}. \"\n",
        "            f\"Choose from {list(models_dict.keys())}\"\n",
        "        )\n",
        "\n",
        "    model = models_dict[model_type](\n",
        "        num_classes=CONFIG['num_classes'],\n",
        "        embedding_dim=CONFIG['embedding_dim'],\n",
        "        dropout=CONFIG['dropout_rate']\n",
        "    )\n",
        "    return model.to(device)\n",
        "\n",
        "\n",
        "# Model configs for experiments\n",
        "# 'early' key maps to EarlyFusionModel\n",
        "# Element-wise addition in shared embedding space\n",
        "MODEL_CONFIGS = [\n",
        "    ('CNN Baseline',    'cnn',       'image'),\n",
        "    ('Text Baseline',   'text',      'text'),\n",
        "    ('Late Fusion',     'late',      'multimodal'),\n",
        "    ('Early Fusion',    'early',     'multimodal'),\n",
        "    ('Attention Fusion','attention', 'multimodal'),\n",
        "]\n",
        "\n",
        "print(\"=\" * 50)\n",
        "print(\"VERIFYING ALL MODEL ARCHITECTURES\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "sample       = next(iter(train_loader))\n",
        "sample_image = sample['image'].to(device)\n",
        "sample_ids   = sample['input_ids'].to(device)\n",
        "sample_mask  = sample['attention_mask'].to(device)\n",
        "\n",
        "for model_name, model_type, input_type in MODEL_CONFIGS:\n",
        "    model = create_model(model_type)\n",
        "    model.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "        if input_type == 'image':\n",
        "            output = model(image=sample_image)\n",
        "        elif input_type == 'text':\n",
        "            output = model(\n",
        "                input_ids=sample_ids,\n",
        "                attention_mask=sample_mask\n",
        "            )\n",
        "        else:\n",
        "            output = model(\n",
        "                image=sample_image,\n",
        "                input_ids=sample_ids,\n",
        "                attention_mask=sample_mask\n",
        "            )\n",
        "\n",
