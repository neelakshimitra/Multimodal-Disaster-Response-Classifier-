        "# Summary and Conclusion\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"THRESHOLD ANALYSIS SUMMARY\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(f\"\\nDefault threshold (0.5):\")\n",
        "print(f\"  Medical F1: {default_medical:.4f}\")\n",
        "print(f\"  Macro F1:   {default_macro:.4f}\")\n",
        "\n",
        "# Find optimal threshold\n",
        "best = max(\n",
        "    threshold_store,\n",
        "    key=lambda x: x['macro_f1']\n",
        ")\n",
        "best_medical = max(\n",
        "    threshold_store,\n",
        "    key=lambda x: x['medical_f1']\n",
        ")\n",
        "\n",
        "print(f\"\\nBest macro F1 threshold: \"\n",
        "      f\"{best['threshold']:.1f} \"\n",
        "      f\"(macro F1 {best['macro_f1']:.4f})\")\n",
        "print(f\"Best medical F1 threshold: \"\n",
        "      f\"{best_medical['threshold']:.1f} \"\n",
        "      f\"(medical F1 {best_medical['medical_f1']:.4f})\")\n",
        "\n",
        "if best['threshold'] == 0.5:\n",
        "    print(\"\\nConclusion: Default threshold (0.5) is already\")\n",
        "    print(\"optimal. Threshold tuning provides no improvement.\")\n",
        "    print(\"The model's probability estimates are well\")\n",
        "    print(\"calibrated for the medical class at default threshold.\")\n",
        "else:\n",
        "    print(f\"\\nConclusion: Threshold {best['threshold']:.1f} \"\n",
        "          f\"outperforms default.\")\n",
        "    print(f\"Macro F1 improvement: \"\n",
        "          f\"{best['macro_f1'] - default_macro:.4f}\")\n",
