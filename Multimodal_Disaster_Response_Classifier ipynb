        "\n",
        "def get_confidence_scores(model_name, model_type,\n",
        "                           checkpoint_path):\n",
        "    \"\"\"\n",
        "    Computes mean confidence for correct and incorrect\n",
        "    predictions on the test set.\n",
        "\n",
        "    Returns:\n",
        "        correct_conf: mean confidence when correct\n",
        "        wrong_conf:   mean confidence when wrong\n",
        "    \"\"\"\n",
        "    model_key = {\n",
        "        'CNN Baseline':    'cnn',\n",
        "        'Text Baseline':   'text',\n",
        "        'Late Fusion':     'late',\n",
        "        'Early Fusion':    'early',\n",
        "        'Attention Fusion':'attention'\n",
        "    }[model_name]\n",
        "\n",
        "    model = create_model(model_key)\n",
        "    model.load_state_dict(\n",
        "        torch.load(\n",
        "            checkpoint_path,\n",
        "            map_location=device,\n",
        "            weights_only=False\n",
        "        )\n",
        "    )\n",
        "    model.eval()\n",
        "\n",
        "    all_confidences = []\n",
        "    all_correct     = []\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for batch in test_loader:\n",
        "            labels = batch['label']\n",
        "\n",
        "            if model_type == 'image':\n",
        "                outputs = model(\n",
        "                    image=batch['image'].to(device)\n",
        "                )\n",
        "            elif model_type == 'text':\n",
        "                outputs = model(\n",
        "                    input_ids=(\n",
        "                        batch['input_ids'].to(device)\n",
        "                    ),\n",
        "                    attention_mask=(\n",
        "                        batch['attention_mask'].to(device)\n",
        "                    )\n",
        "                )\n",
        "            else:\n",
        "                outputs = model(\n",
        "                    image=batch['image'].to(device),\n",
        "                    input_ids=(\n",
        "                        batch['input_ids'].to(device)\n",
        "                    ),\n",
        "                    attention_mask=(\n",
        "                        batch['attention_mask'].to(device)\n",
        "                    )\n",
        "                )\n",
        "\n",
        "            probs = F.softmax(outputs, dim=1)\n",
        "            confidence, preds = probs.max(dim=1)\n",
        "            correct = (preds.cpu() == labels)\n",
        "\n",
        "            all_confidences.extend(\n",
        "                confidence.cpu().numpy()\n",
        "            )\n",
        "            all_correct.extend(correct.numpy())\n",
        "\n",
        "    correct_confs = [\n",
        "        c for c, r in zip(all_confidences, all_correct)\n",
        "        if r\n",
        "    ]\n",
        "    wrong_confs = [\n",
        "        c for c, r in zip(all_confidences, all_correct)\n",
        "        if not r\n",
        "    ]\n",
        "\n",
        "    correct_conf = (\n",
        "        np.mean(correct_confs) if correct_confs else 0.0\n",
        "    )\n",
        "    wrong_conf = (\n",
        "        np.mean(wrong_confs) if wrong_confs else 0.0\n",
        "    )\n",
