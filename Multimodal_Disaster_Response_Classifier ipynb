        "# - CrisisMMD Task 2 agreed labels used (Alam et al. 2018)\n",
        "# - Event-level alignment: each tweet paired with randomly\n",
        "#   sampled satellite image from same disaster event\n",
        "# - xBD train images used for train/val datasets\n",
        "# - xBD test images used for test dataset only\n",
        "\n",
        "# 3.1 Load and Prepare CrisisMMD Annotations\n",
        "\n",
        "def load_crisismmd_annotations(split):\n",
        "    \"\"\"\n",
        "    Load CrisisMMD humanitarian annotations for a split.\n",
        "\n",
        "    Args:\n",
        "        split: 'train', 'dev', or 'test'\n",
        "    Returns:\n",
        "        DataFrame with filtered and mapped labels\n",
        "    \"\"\"\n",
        "    path = (ANNOTATIONS_PATH +\n",
        "            '/crisismmd_datasplit_agreed_label/' +\n",
        "            f'task_humanitarian_text_img_agreed_lab'\n",
        "            f'_{split}.tsv')\n",
        "\n",
        "    df = pd.read_csv(path, sep='\\t')\n",
        "\n",
        "    # Filter to Harvey and Mexico events only\n",
        "    target_events = ['hurricane_harvey', 'mexico_earthquake']\n",
        "    df = df[df['event_name'].isin(target_events)].copy()\n",
        "\n",
        "    # Remove not_humanitarian samples\n",
        "    df = df[df['label_text'] != 'not_humanitarian'].copy()\n",
        "\n",
        "    # Apply label mapping to four target categories\n",
        "    df['target_label'] = df['label_text'].map(\n",
        "        CONFIG['label_map']\n",
        "    )\n",
        "\n",
        "    df = df.dropna(subset=['target_label']).copy()\n",
        "    df = df.reset_index(drop=True)\n",
        "\n",
        "    print(f\"{split} set: {len(df)} samples\")\n",
        "    print(df['target_label'].value_counts())\n",
        "\n",
        "    return df\n",
        "\n",
        "print(\"=\" * 50)\n",
        "print(\"Loading CrisisMMD Annotations\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "train_df = load_crisismmd_annotations('train')\n",
        "print()\n",
        "val_df   = load_crisismmd_annotations('dev')\n",
        "print()\n",
        "test_df  = load_crisismmd_annotations('test')\n",
        "\n",
        "# 3.2 Create Label Encoder\n",
        "\n",
        "CLASS_NAMES   = CONFIG['class_names']\n",
        "label_to_idx  = {\n",
        "    label: idx for idx, label in enumerate(CLASS_NAMES)\n",
        "}\n",
        "idx_to_label  = {\n",
        "    idx: label for label, idx in label_to_idx.items()\n",
        "}\n",
        "\n",
        "print(\"\\nLabel encoding:\")\n",
        "for label, idx in label_to_idx.items():\n",
        "    print(f\"  {idx}: {label}\")\n",
        "\n",
        "# 3.3 Build xBD Image Lookups\n",
        "# Separate lookups for train and test splits to prevent data leakage between splits.\n",
        "\n",
        "def build_xbd_lookup(xbd_split='train'):\n",
        "    \"\"\"\n",
        "    Builds dictionary mapping event name to list of\n",
        "    post-disaster xBD satellite image paths.\n",
        "\n",
        "    Args:\n",
        "        xbd_split: 'train' or 'test'\n",
        "    Returns:\n",
        "        dict mapping event name to list of image paths\n",
        "    \"\"\"\n",
        "    event_name_map = {\n",
        "        'hurricane_harvey':  'hurricane-harvey',\n",
        "        'mexico_earthquake': 'mexico-earthquake'\n",
        "    }\n",
        "\n",
        "    xbd_lookup = {}\n",
        "\n",
        "    for crisismmd_name, xbd_name in event_name_map.items():\n",
        "        image_list = []\n",
        "\n",
        "        img_folder = XBD_PATH + f'/{xbd_split}/images'\n",
        "        if os.path.exists(img_folder):\n",
        "            for fname in os.listdir(img_folder):\n",
        "                if (xbd_name in fname and\n",
        "                        'post_disaster' in fname and\n",
        "                        fname.endswith('.png')):\n",
        "                    full_path = os.path.join(\n",
        "                        img_folder, fname\n",
        "                    )\n",
        "                    image_list.append(full_path)\n",
        "\n",
        "        xbd_lookup[crisismmd_name] = image_list\n",
        "        print(f\"{crisismmd_name} ({xbd_split}): \"\n",
        "              f\"{len(image_list)} satellite images\")\n",
        "\n",
        "    return xbd_lookup\n",
        "\n",
        "print(\"\\n\" + \"=\" * 50)\n",
        "print(\"Building xBD Image Lookups\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "print(\"\\nTrain/Val lookup (xBD train split only):\")\n",
        "xbd_lookup_train = build_xbd_lookup(xbd_split='train')\n",
        "\n",
        "print(\"\\nTest lookup (xBD test split only):\")\n",
        "xbd_lookup_test = build_xbd_lookup(xbd_split='test')\n",
        "\n",
        "# 3.4 Define Image Transforms\n",
        "# ImageNet normalisation used since ResNet-18 was\n",
        "# pretrained on ImageNet.\n",
        "\n",
        "IMAGENET_MEAN = [0.485, 0.456, 0.406]\n",
        "IMAGENET_STD  = [0.229, 0.224, 0.225]\n",
        "\n",
        "train_transform = transforms.Compose([\n",
        "    transforms.Resize((\n",
        "        CONFIG['image_size'],\n",
        "        CONFIG['image_size']\n",
        "    )),\n",
        "    transforms.RandomHorizontalFlip(),\n",
        "    transforms.RandomVerticalFlip(),\n",
        "    transforms.ColorJitter(\n",
        "        brightness=0.2, contrast=0.2\n",
        "    ),\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Normalize(\n",
        "        mean=IMAGENET_MEAN,\n",
        "        std=IMAGENET_STD\n",
        "    )\n",
        "])\n",
        "\n",
        "val_transform = transforms.Compose([\n",
        "    transforms.Resize((\n",
        "        CONFIG['image_size'],\n",
        "        CONFIG['image_size']\n",
        "    )),\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Normalize(\n",
        "        mean=IMAGENET_MEAN,\n",
        "        std=IMAGENET_STD\n",
        "    )\n",
        "])\n",
        "\n",
        "ZERO_IMAGE = torch.zeros(\n",
        "    3,\n",
        "    CONFIG['image_size'],\n",
        "    CONFIG['image_size']\n",
        ")\n",
        "\n",
        "print(\"\\nImage transforms defined\")\n",
        "\n",
        "# 3.5 Initialise DistilBERT Tokenizer\n",
        "\n",
        "tokenizer = DistilBertTokenizer.from_pretrained(\n",
        "    'distilbert-base-uncased'\n",
        ")\n",
        "print(\"DistilBERT tokenizer loaded\")\n",
        "\n",
        "# 3.6 Custom Dataset Class\n",
        "\n",
        "class HumanitarianDataset(Dataset):\n",
        "    \"\"\"\n",
        "    Multimodal dataset combining xBD satellite imagery\n",
        "    and CrisisMMD tweet text for humanitarian needs\n",
        "    classification.\n",
        "\n",
        "    Each tweet is paired with a randomly sampled\n",
        "    post-disaster satellite image from the same disaster\n",
        "    event. Images and tweets are NOT matched at the\n",
        "    scene or pixel level.\n",
        "\n",
        "    Args:\n",
        "        dataframe:   CrisisMMD annotation DataFrame\n",
        "        xbd_lookup:  dict mapping event name to image paths\n",
        "        tokenizer:   DistilBERT tokenizer\n",
        "        transform:   image transforms to apply\n",
        "        max_length:  maximum token length for text\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, dataframe, xbd_lookup,\n",
        "                 tokenizer, transform,\n",
        "                 max_length=128):\n",
        "        self.df           = dataframe.reset_index(drop=True)\n",
        "        self.xbd_lookup   = xbd_lookup\n",
        "        self.tokenizer    = tokenizer\n",
        "        self.transform    = transform\n",
        "        self.max_length   = max_length\n",
        "        self.label_to_idx = label_to_idx\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.df)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        row = self.df.iloc[idx]\n",
        "\n",
        "        # Tokenise tweet\n",
        "        tweet_text = str(row['tweet_text'])\n",
        "        encoding = self.tokenizer(\n",
        "            tweet_text,\n",
        "            max_length=self.max_length,\n",
        "            padding='max_length',\n",
        "            truncation=True,\n",
        "            return_tensors='pt'\n",
        "        )\n",
        "        input_ids      = encoding['input_ids'].squeeze(0)\n",
        "        attention_mask = encoding[\n",
        "            'attention_mask'\n",
        "        ].squeeze(0)\n",
        "\n",
        "        # Sample satellite image from same event\n",
        "        event = row['event_name']\n",
        "\n",
        "        if (event in self.xbd_lookup and\n",
        "                len(self.xbd_lookup[event]) > 0):\n",
        "            img_path = random.choice(\n",
        "                self.xbd_lookup[event]\n",
        "            )\n",
        "        else:\n",
        "            all_images = []\n",
        "            for imgs in self.xbd_lookup.values():\n",
        "                all_images.extend(imgs)\n",
        "            if all_images:\n",
        "                img_path = random.choice(all_images)\n",
        "            else:\n",
        "                image = ZERO_IMAGE.clone()\n",
        "                label = self.label_to_idx[\n",
        "                    row['target_label']\n",
        "                ]\n",
        "                return {\n",
        "                    'input_ids':      input_ids,\n",
        "                    'attention_mask': attention_mask,\n",
        "                    'image':          image,\n",
        "                    'label':          torch.tensor(\n",
        "                        label, dtype=torch.long\n",
